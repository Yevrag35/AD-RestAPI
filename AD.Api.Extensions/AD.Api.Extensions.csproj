<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>AD.Api</RootNamespace>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Exceptions\Services\**" />
    <EmbeddedResource Remove="Exceptions\Services\**" />
    <None Remove="Exceptions\Services\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
  </ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="AD.Api.Assemblies.DependencyAssemblyAttribute" />
	</ItemGroup>

	<ItemGroup>
	    <Using Include="AD.Api.Reflection" />
		<Using Include="AD.Api.Resources.ErrorStrings" Alias="Errors" />
		<Using Include="Microsoft.Extensions.Configuration" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
	    <Using Include="System.Buffers" />
	    <Using Include="System.Collections" />
		<Using Include="System.Diagnostics" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.IO" />
		<Using Include="System.Reflection" />
	    <Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="System.Text" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AD.Api.Attributes\AD.Api.Attributes.csproj" />
	  <ProjectReference Include="..\AD.Api.Resources\AD.Api.Resources.csproj" />
	</ItemGroup>
	
	<ItemGroup>
      <Compile Update="**\*-*.cs">
		<DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('$([System.String]::Copy(%(Filename)))', '^(.+)\-.+$', '$1.cs'))</DependentUpon>
      </Compile>
	</ItemGroup>
</Project>
